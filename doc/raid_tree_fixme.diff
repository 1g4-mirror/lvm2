diff --git a/test/shell/integrity-onecommit.sh b/test/shell/integrity-onecommit.sh
new file mode 100755
index 000000000..663e5a70c
--- /dev/null
+++ b/test/shell/integrity-onecommit.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+
+# Copyright (C) 2026 Red Hat, Inc. All rights reserved.
+#
+# This copyrighted material is made available to anyone wishing to use,
+# modify, copy, or redistribute it subject to the terms and conditions
+# of the GNU General Public License v.2.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write to the Free Software Foundation,
+# Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+
+. lib/inittest --skip-with-lvmpolld
+
+aux have_integrity 1 5 0 || skip
+
+aux prepare_devs 3 64
+aux clear_devs "$dev1" "$dev2" "$dev3"
+vgcreate $SHARED $vg "$dev1" "$dev2" "$dev3"
+
+lvcreate --yes --type raid1 -m 2 --nosync -l 8 --raidintegrity y -n $lv1 \
+	$vg "$dev1" "$dev2" "$dev3"
+aux wait_recalc $vg/${lv1}_rimage_0
+aux wait_recalc $vg/${lv1}_rimage_1
+aux wait_recalc $vg/${lv1}_rimage_2
+aux wait_recalc $vg/$lv1
+
+uuid1=$(get lv_field "$vg/${lv1}_rimage_1" lv_uuid -a)
+uuid2=$(get lv_field "$vg/${lv1}_rimage_2" lv_uuid -a)
+dd if=/dev/urandom of=expected bs=1M count=1
+dd if=expected of="$DM_DEV_DIR/$vg/$lv1" bs=1M conv=fsync
+
+if ! lvconvert --yes -m 1 $vg/$lv1 "$dev1"; then
+	dmsetup ls --tree
+	dmsetup info -c -o name,uuid,minor
+	die "one-commit integrity reduction failed"
+fi
+
+check lv_field "$vg/${lv1}_rimage_0" lv_uuid "$uuid1" -a
+check lv_field "$vg/${lv1}_rimage_1" lv_uuid "$uuid2" -a
+check lv_field "$vg/${lv1}_rimage_0" segtype integrity -a
+check lv_field "$vg/${lv1}_rimage_1" segtype integrity -a
+dmsetup info -c -o name > dm-info
+not grep "${vg}-${lv1}_rimage_.*extracted" dm-info
+lvchange -an "$vg/$lv1"
+lvchange -ay "$vg/$lv1"
+dd if="$DM_DEV_DIR/$vg/$lv1" of=actual bs=1M count=1
+cmp expected actual
+
+vgremove -ff $vg
